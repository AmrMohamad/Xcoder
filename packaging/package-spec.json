{
  "schema_version": "xcoder.package-spec.v1",
  "root_prefix": "xcode/{version}/",
  "required_paths": [
    ".agents/plugins/marketplace.json",
    ".codex-plugin/plugin.json",
    ".mcp.json",
    "hooks/hooks.json",
    "packaging/package-spec.json",
    "bin/xcode",
    "bin/xcode-mcp",
    "bin/xcode-mcp-server",
    "bin/xcode-native-helper",
    "bin/XcodeNativeHelper.app/Contents/Info.plist",
    "bin/XcodeNativeHelper.app/Contents/MacOS/xcode-native-helper",
    "README.md",
    "LICENSE"
  ],
  "required_globs": [
    "scripts/*.py",
    "skills/*/SKILL.md",
    "native/XcodeMCPServer/Sources/**/*.swift",
    "native/XcodeMCPServer/Tests/**/*.swift",
    "native/XcodeNativeHelper/Sources/**/*.swift"
  ],
  "forbidden_globs": [
    "**/.DS_Store",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.build/**",
    "**/DerivedData/**",
    "**/*.p8",
    "**/.env",
    "**/*.mobileprovision",
    "**/*.zip"
  ],
  "executables": [
    "bin/xcode",
    "bin/xcode-mcp",
    "bin/xcode-mcp-server",
    "bin/xcode-native-helper",
    "bin/XcodeNativeHelper.app/Contents/MacOS/xcode-native-helper"
  ],
  "binaries": [
    "bin/xcode-mcp-server",
    "bin/XcodeNativeHelper.app/Contents/MacOS/xcode-native-helper"
  ],
  "allowed_symlinks": [],
  "limits": {
    "maximum_entries": 10000,
    "maximum_total_uncompressed_bytes": 200000000,
    "maximum_single_entry_bytes": 100000000,
    "maximum_compression_ratio": 100
  }
}
